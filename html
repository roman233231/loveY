
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Yustyna ❤️</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>❤️</text></svg>">
<style>
  body {
    margin: 0;
    background: radial-gradient(circle at center, #000 60%, #1a001a);
    overflow: hidden;
    cursor: pointer;
  }
  canvas {
    display: block;
  }
</style>
</head>
<body>
<canvas id="canvas"></canvas>
<script>
const canvas = document.getElementById("canvas");
const ctx = canvas.getContext("2d");

let canvasWidth = window.innerWidth;
let canvasHeight = window.innerHeight;
canvas.width = canvasWidth;
canvas.height = canvasHeight;

let texts = ["Yustyna", "I ❤️ You"];
let currentIndex = 0;
let currentText = texts[currentIndex];

const hearts = [];

let fontSize = canvasWidth < 600 ? 100 : 180; 
ctx.textAlign = "center";
ctx.textBaseline = "middle";

function createHeart(targetX, targetY) {
  const side = Math.floor(Math.random() * 4);
  let startX, startY;
  if (side === 0) { startX = Math.random() * canvas.width; startY = -60; }
  else if (side === 1) { startX = canvas.width + 60; startY = Math.random() * canvas.height; }
  else if (side === 2) { startX = Math.random() * canvas.width; startY = canvas.height + 60; }
  else { startX = -60; startY = Math.random() * canvas.height; }

  return {
    x: startX,
    y: startY,
    targetX,
    targetY,
    size: Math.random() * 2 + 1.5,
    pulse: Math.random() * 2 * Math.PI,
    arrived: false,
    speed: 0.04 + Math.random() * 0.03
  };
}

function drawHeart(x, y, size) {
  ctx.save();
  ctx.translate(x, y);
  ctx.beginPath();
  ctx.moveTo(0, -size / 2);
  ctx.bezierCurveTo(size / 2, -size, size, 0, 0, size);
  ctx.bezierCurveTo(-size, 0, -size / 2, -size, 0, -size / 2);
  ctx.closePath();

  const gradient = ctx.createLinearGradient(-size, -size, size, size);
  gradient.addColorStop(0, "#ff33cc");
  gradient.addColorStop(1, "#ff99ff");

  ctx.strokeStyle = gradient;
  ctx.lineWidth = 2;
  ctx.stroke();
  ctx.restore();
}

function init() {
  hearts.length = 0;

  const off = document.createElement("canvas");
  const offCtx = off.getContext("2d");
  off.width = canvas.width;
  off.height = canvas.height;

  fontSize = canvasWidth < 600 ? 100 : 180;
  offCtx.font = `${fontSize}px Arial Black`;
  offCtx.textAlign = "center";
  offCtx.textBaseline = "middle";
  offCtx.fillStyle = "white";
  offCtx.fillText(currentText, canvas.width / 2, canvas.height / 2);

  const imageData = offCtx.getImageData(0, 0, canvas.width, canvas.height).data;

  const step = canvasWidth < 600 ? 4 : 6; // менший крок = більше сердець на мобільному
  for (let y = 0; y < canvas.height; y += step) {
    for (let x = 0; x < canvas.width; x += step) {
      const index = (y * canvas.width + x) * 4;
      if (imageData[index + 3] > 100) {
        hearts.push(createHeart(x, y));
      }
    }
  }
}

function animate() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  for (let heart of hearts) {
    if (!heart.arrived) {
      const dx = heart.targetX - heart.x;
      const dy = heart.targetY - heart.y;
      heart.x += dx * heart.speed;
      heart.y += dy * heart.speed;

      if (Math.abs(dx) < 1 && Math.abs(dy) < 1) heart.arrived = true;
    } else {
      heart.pulse += 0.05;
    }

    const hSize = heart.size + (heart.arrived ? Math.sin(heart.pulse) * 1.3 : 0);
    drawHeart(heart.x, heart.y, hSize);
  }

  requestAnimationFrame(animate);
}

canvas.addEventListener("click", (e) => {
  const textX = canvas.width / 2;
  const textY = canvas.height / 2;
  const clickRadius = 200; 
  if (Math.abs(e.offsetX - textX) < clickRadius && Math.abs(e.offsetY - textY) < clickRadius) {
    currentIndex = (currentIndex + 1) % texts.length;
    currentText = texts[currentIndex];
    init();
  }
});

init();
animate();

window.addEventListener("resize", () => {
  canvasWidth = window.innerWidth;
  canvasHeight = window.innerHeight;
  canvas.width = canvasWidth;
  canvas.height = canvasHeight;
  init();
});
</script>
</body>
</html>
